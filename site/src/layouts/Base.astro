---
import '../styles/global.css';
import { empresa, seo, metaPixel } from '../config';

interface Props {
  titulo?: string;
  descricao?: string;
}
const { titulo = seo.titulo, descricao = seo.descricao } = Astro.props;
// Astro.site pode vir vazio no dev depois de um reinício a quente do config —
// sem o fallback, `new URL` lança "Invalid URL" e a página inteira não renderiza.
const canonica = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <!-- viewport-fit=cover: a barra fixa de baixo respeita a área do gesto do iPhone -->
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <!-- Barra do navegador no Android na mesma cor do cabeçalho -->
    <meta name="theme-color" content="#FF0076" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon-512.png" />
    <!-- Ícone ao "adicionar à tela de início": fundo branco (transparente o
         iPhone pinta de preto) -->
    <link rel="apple-touch-icon" href="/icone-app.png" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={empresa.nome} />
    <!-- Imagem do link colado no WhatsApp/Instagram/Facebook. Gerada por
         imagem-compartilhamento/render.cjs; o endereço precisa ser completo. -->
    <meta property="og:image" content={new URL('/og-image.jpg', Astro.site ?? Astro.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Gestante sorrindo e o texto: Mamãe, descubra se você tem direito a receber até R$ 15.900. Análise gratuita." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL('/og-image.jpg', Astro.site ?? Astro.url).href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Onest:wght@400;500;600;700;800&display=swap"
    />

    {metaPixel.id && (
      <>
        <!-- Pixel da Meta: código padrão. Os eventos de conversão ficam no
             Formulario.astro (Lead, CompleteRegistration, Contact). -->
        <script is:inline define:vars={{ pixelId: metaPixel.id }}>
          !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
          n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;
          n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;
          t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,
          document,'script','https://connect.facebook.net/en_US/fbevents.js');
          fbq('init', pixelId);
          fbq('track', 'PageView');
        </script>
        <noscript>
          <img height="1" width="1" style="display:none" alt=""
            src={`https://www.facebook.com/tr?id=${metaPixel.id}&ev=PageView&noscript=1`} />
        </noscript>
      </>
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
