---
import { Picture } from 'astro:assets';
import { linkWhatsApp, provaSocial } from '../config';
import fotoQuarto from '../assets/fotos/gravida-quarto.jpg';
import cartaoAuxilio from '../assets/cartao-auxilio.png';

// Segunda seção: faixa rosa de alerta + bloco de destaque com foto, texto,
// números e CTA.
//
// Foto: gestante no quarto do bebê já montado (Unsplash, uso comercial livre).
// A ideia de "dinheiro pra receber" vem do cartão com o valor em reais por
// cima da foto — não existe foto gratuita de gestante com dinheiro, e as de
// "mulher segurando dinheiro" mostram dólar, que destoa num anúncio de INSS.
---

<section class="destaque" aria-labelledby="destaque-titulo">
  <!-- Faixa de alerta -->
  <div class="faixa">
    <div class="envelope faixa__interno">
      <p class="faixa__titulo">
        Atenção, mãe ou gestante <span class="faixa__nota">(filhos até 5 anos)</span>
      </p>
      <p class="faixa__texto">
        Te ajudamos a receber até <strong>R$&nbsp;15.900,00</strong> de auxílio maternidade.
      </p>
    </div>
  </div>

  <!-- Bloco de destaque -->
  <div class="secao destaque__corpo">
    <div class="envelope destaque__grade">
      <figure class="destaque__figura">
        <Picture
          class="destaque__foto"
          src={fotoQuarto}
          alt="Gestante na porta do quarto do bebê, com o berço já montado"
          widths={[400, 640, 960]}
          sizes="(max-width: 880px) calc(100vw - 44px), 480px"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
        />
        <div class="cartao-valor" aria-hidden="true">
          <!-- Cartão "Auxílio Maternidade" da marca (13/09/2026), no lugar do
               ícone de dinheiro. Recortado do fundo e endireitado (a arte vinha
               inclinada, em perspectiva); o logo antigo impresso na arte foi
               trocado pelo LoveMãe branco. O original está em
               marketing/referencias/site/cartao-auxilio-original.png -->
          <Picture
            class="cartao-valor__cartao"
            src={cartaoAuxilio}
            alt=""
            widths={[140, 200, 270]}
            sizes="(max-width: 420px) 70px, 88px"
            formats={['avif', 'webp']}
          />
          <span class="cartao-valor__texto">
            <span class="cartao-valor__rotulo">Auxílio-maternidade</span>
            <span class="cartao-valor__numero">até R$&nbsp;15.900,00</span>
          </span>
        </div>
      </figure>

      <div class="destaque__texto">
        <p class="destaque__pergunta">+ Segurança e amparo para as mamães recentes.</p>
        <h2 id="destaque-titulo" class="destaque__titulo">Você não sabe se tem direito ao auxílio maternidade?</h2>
        <!-- Balão de alerta (13/09/2026) -->
        <p class="destaque__alerta">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="9.5" />
            <path d="M12 7.5v5.5M12 16.6v.1" />
          </svg>
          <span>Não perca seu benefício por falta de informação</span>
        </p>

        <p class="destaque__intro">
          Já ajudamos mamães a receberem seu auxílio maternidade com análise
          gratuita e valores que variam de <span class="sem-quebra">R$ 6.900,00</span>
          a <span class="sem-quebra">R$ 15.900,00</span>.
        </p>

        <ul class="numeros">
          {provaSocial.map((item) => (
            <li class="numero">
              <span class="numero__valor">{item.numero}</span>
              <span class="numero__rotulo">{item.rotulo}</span>
            </li>
          ))}
        </ul>

        <a class="botao botao--whats destaque__botao" href={linkWhatsApp('destaque')}>
          <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true">
            <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.74 2.66 4.22 3.73.59.25 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"/>
          </svg>
          Descobrir se tenho direito
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Faixa rosa ---------- */
  .faixa {
    background: var(--destaque);
    color: #fff;
    padding-block: clamp(26px, 3.6vw, 38px);
  }
  .faixa__interno {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
  }
  .faixa__titulo {
    font-family: var(--fonte-titulo);
    font-weight: var(--peso-titulo);
    letter-spacing: var(--kerning-titulo);
    font-size: clamp(23px, 3.2vw, 32px);
    line-height: 1.2;
    text-wrap: balance;
  }
  /* O recorte de idade é condição, não manchete */
  .faixa__nota {
    display: inline-block;
    font-size: .62em;
    font-weight: 600;
    color: rgba(255, 255, 255, .84);
    letter-spacing: 0;
  }
  .faixa__texto {
    font-size: clamp(16px, 2vw, 19px);
    color: rgba(255, 255, 255, .94);
  }
  .faixa__texto strong { color: #fff; font-weight: 700; white-space: nowrap; }

  /* ---------- Bloco de destaque ---------- */
  .destaque__corpo { background: var(--fundo); }

  .destaque__grade {
    display: grid;
    grid-template-columns: .9fr 1.1fr;
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }

  .destaque__figura {
    position: relative;
    margin: 0;
  }
  .destaque__foto {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 72% 55%; /* mantém a gestante e a barriga no quadro */
    border-radius: var(--raio-imagem);
  }

  /* Cartão com o valor: é ele que traz o "dinheiro pra receber" pra foto.
     Transborda a borda direita da foto, na direção do texto. */
  .cartao-valor {
    position: absolute;
    right: -26px;
    bottom: 34px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 20px 14px 14px;
    background: var(--fundo-card);
    border-radius: 16px;
    box-shadow: 0 12px 30px rgba(26, 37, 48, .16);
  }
  /* O cartão da marca no lugar do ícone, reto (pedido de 13/09/2026). A
     sombra rosa suave descola ele do fundo branco. */
  .cartao-valor__cartao {
    flex: none;
    width: 88px;
    height: auto;
    filter: drop-shadow(0 4px 7px color-mix(in srgb, var(--destaque) 22%, transparent));
  }
  .cartao-valor__texto { display: flex; flex-direction: column; line-height: 1.2; }
  .cartao-valor__rotulo {
    font-size: 14.5px;
    font-weight: 600;
    color: var(--destaque); /* rosa (pedido de 13/09/2026) — 5,37:1 no branco */
  }
  .cartao-valor__numero {
    margin-top: 4px;
    font-family: var(--fonte-titulo);
    font-weight: 800;
    font-size: 22px;
    color: var(--texto);
  }

  /* ---------- Coluna do texto ---------- */
  /* Título virou a pergunta (13/09/2026), mais longa: um pouco menor pra
     caber em 2 linhas no computador */
  .destaque__titulo {
    color: var(--texto);
    font-size: clamp(28px, 3.5vw, 40px);
  }
  /* Pergunta de abertura em cinza, acima do título — mesma forma usada na
     "Conheça seus direitos". */
  /* Padrão do site: linha pequena acima do título em rosa, título em preto,
     descrições em cinza (igual ao topo da página). */
  .destaque__pergunta {
    margin-bottom: 12px;
    font-family: var(--fonte-titulo);
    font-weight: 700;
    font-size: clamp(16px, 1.9vw, 19px);
    line-height: 1.35;
    color: var(--destaque);
  }
  /* Balão de alerta (13/09/2026): fundo rosa, texto branco e a "pontinha" de
     balão embaixo. 19px em negrito conta como texto grande, então o branco
     passa em contraste nos dois rosas (5,57:1 no atual, 3,8:1 no do logo). */
  .destaque__alerta {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    max-width: 100%;
    margin-top: 22px;
    padding: 12px 18px;
    border-radius: 16px;
    background: var(--destaque);
    color: #fff;
    font-weight: 700;
    font-size: 19px;
    line-height: 1.3;
    box-shadow: 0 8px 20px color-mix(in srgb, var(--destaque) 25%, transparent);
  }
  .destaque__alerta::after {
    content: '';
    position: absolute;
    left: 26px;
    bottom: -7px;
    width: 16px;
    height: 16px;
    background: inherit;
    border-radius: 3px;
    transform: rotate(45deg);
  }
  .destaque__alerta svg { flex: none; width: 22px; height: 22px; }
  .destaque__intro {
    margin-top: 22px;
    max-width: 50ch;
    color: var(--texto-apoio);
    font-size: 17px;
    line-height: 1.55;
  }
  .sem-quebra { white-space: nowrap; }

  /* Números: o valor é o que o olho pega primeiro; o rótulo explica */
  .numeros {
    list-style: none;
    margin: 32px 0 0;
    padding: 24px 0 0;
    border-top: 1px solid var(--linha);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .numero { display: flex; flex-direction: column; gap: 6px; }
  .numero__valor {
    font-family: var(--fonte-titulo);
    font-weight: 800;
    font-size: clamp(32px, 4.4vw, 44px);
    line-height: 1;
    letter-spacing: -.02em;
    color: var(--destaque);
    white-space: nowrap;
  }
  .numero__rotulo {
    font-size: 15px;
    line-height: 1.35;
    color: var(--texto-apoio);
  }

  .destaque__botao { margin-top: 34px; }

  @media (max-width: 880px) {
    .destaque__grade { grid-template-columns: 1fr; }
    .destaque__figura { max-width: 460px; }
    .destaque__foto { aspect-ratio: 4 / 4.4; }
    /* No celular o cartão monta na borda de baixo da foto, sobre o chão —
       dentro dela, cobriria as mãos e a barriga, que são o assunto. */
    .destaque__figura { margin-bottom: 30px; }
    .cartao-valor { left: 14px; right: auto; bottom: -26px; }
  }
  /* Celular (13/09/2026) */
  @media (max-width: 560px) {
    /* "Atenção, mãe ou gestante" numa linha; a idade logo embaixo */
    .faixa__titulo { font-size: clamp(21px, 6vw, 26px); }
    .faixa__nota { display: block; margin-top: 2px; font-size: .72em; }

    /* Números em linhas: o número grande à esquerda e a explicação ao lado,
       em vez de três colunas apertadas com o texto em 3 linhas */
    .numeros { grid-template-columns: 1fr; gap: 14px; }
    .numero { flex-direction: row; align-items: center; gap: 14px; }
    .numero__valor { min-width: 104px; font-size: 32px; }
    .numero__rotulo { font-size: 15.5px; }
  }
  @media (max-width: 420px) {
    .destaque__botao { width: 100%; }
    .cartao-valor { gap: 10px; padding: 12px 16px 12px 12px; }
    .cartao-valor__cartao { width: 70px; }
    .cartao-valor__numero { font-size: 19px; white-space: nowrap; }
  }
  /* Celular bem pequeno: cartão e valor um pouco menores pra "até R$ 15.900,00"
     não quebrar em duas linhas */
  @media (max-width: 340px) {
    .cartao-valor__cartao { width: 58px; }
    .cartao-valor__numero { font-size: 17.5px; }
  }
</style>
