---
import { linkWhatsApp } from '../config';
// Botão de WhatsApp fixo na tela o tempo todo (pedido de 13/09/2026: não some
// mais quando outros botões aparecem). As referências do nicho fazem o mesmo.
// É o padrão do nicho e faz sentido: a decisão de chamar costuma acontecer no
// meio da leitura, não no fim da página.
//
// No celular (13/09/2026, opção A): vira uma barra de ponta a ponta embaixo,
// na zona do polegar. A página reserva o espaço dela, então não cobre texto.
// No computador continua a pílula no canto.
---

<div class="flutuante-barra">
  <a
    class="flutuante"
    href={linkWhatsApp('botão flutuante')}
    aria-label="Fazer minha análise gratuita pelo WhatsApp"
  >
    <svg viewBox="0 0 24 24" width="24" height="24" fill="currentColor" aria-hidden="true">
      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.22 8.22 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.83 2.42a8.19 8.19 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.17 0-.43.06-.66.31-.23.25-.86.85-.86 2.07s.89 2.4 1.01 2.56c.12.17 1.74 2.66 4.22 3.73.59.25 1.05.41 1.41.52.59.19 1.13.16 1.56.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.14-1.18-.06-.11-.22-.17-.47-.29Z"/>
    </svg>
    <span class="flutuante__curto">Análise gratuita</span>
    <span class="flutuante__longo">Fazer minha análise gratuita</span>
  </a>
</div>

<style>
  /* ---------- Computador: pílula no canto ---------- */
  .flutuante-barra {
    position: fixed;
    right: 18px;
    bottom: 18px;
    z-index: 60;
  }
  .flutuante {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 11px;
    padding: 14px 22px;
    border-radius: var(--raio-botao);
    background: var(--cta-whatsapp);
    color: #fff;
    text-decoration: none;
    font-family: var(--fonte-corpo);
    font-weight: var(--peso-forte);
    font-size: 16px;
    white-space: nowrap;
    box-shadow: 0 6px 20px color-mix(in srgb, var(--cta-whatsapp) 34%, transparent);
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .flutuante svg { flex: none; }
  .flutuante:hover {
    transform: translateY(-2px);
    box-shadow: 0 9px 26px color-mix(in srgb, var(--cta-whatsapp) 42%, transparent);
  }
  .flutuante__longo { display: none; }

  /* ---------- Celular: barra de ponta a ponta ---------- */
  @media (max-width: 760px) {
    .flutuante-barra {
      left: 0;
      right: 0;
      bottom: 0;
      padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
      background: rgba(255, 255, 255, .97);
      border-top: 1px solid var(--linha);
      box-shadow: 0 -6px 20px rgba(16, 34, 50, .10);
    }
    .flutuante {
      width: 100%;
      min-height: 52px;
      padding: 12px 18px;
      font-size: clamp(16px, 4.6vw, 18px);
      box-shadow: none;
    }
    .flutuante:hover { transform: none; box-shadow: none; }
    .flutuante__curto { display: none; }
    .flutuante__longo { display: inline; }
  }

  /* A página reserva o espaço da barra: o fim do rodapé nunca fica embaixo dela */
  @media (max-width: 760px) {
    :global(body) { padding-bottom: calc(74px + env(safe-area-inset-bottom)); }
  }
</style>
