---
import { empresa, linkWhatsApp } from '../config';
---

<header class="cabecalho">
  <div class="envelope cabecalho__interno">
    <a href="/" class="cabecalho__marca" aria-label={`${empresa.nome} — início`}>
      <img src="/logo.png" alt={empresa.nome} width="1200" height="1040" />
    </a>
    <a class="botao botao--whats cabecalho__acao" href={linkWhatsApp('topo do site')}>
      Análise gratuita
    </a>
  </div>
</header>

<style>
  /* v2 · cabeçalho branco com o logo colorido e uma linha na cor da variante */
  .cabecalho {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--fundo);
    border-bottom: 3px solid var(--destaque);
    box-shadow: 0 2px 10px rgba(26, 37, 48, .06);
  }
  .cabecalho__interno {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 8px;
  }
  .cabecalho__marca img { width: 70px; height: auto; }
  .cabecalho__acao { font-size: 15px; min-height: 40px; padding: 9px 20px; }

  @media (max-width: 520px) {
    .cabecalho__marca img { width: 60px; }
    .cabecalho__acao { font-size: 14px; padding: 8px 16px; min-height: 38px; }
  }
</style>
