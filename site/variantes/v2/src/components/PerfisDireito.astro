---
import { linkWhatsApp } from '../config';

// v2 · cabeçalho alinhado à esquerda, cartões em fundo suave (sem borda),
// texto alinhado à esquerda. Destaque continua na desempregada.
const perfis = [
  { titulo: 'Trabalhadoras com carteira assinada (CLT)', texto: 'Mamães que estavam trabalhando de carteira assinada durante a gravidez e não receberam o benefício.', foto: '/perfil-clt.jpg', alt: 'Mulher segurando a carteira de trabalho' },
  { titulo: 'Mães MEI e autônomas', texto: 'Mamães que trabalham por conta própria ou como MEI e contribuem com o INSS.', foto: '/perfil-autonoma.jpg', alt: 'Mulher trabalhando por conta própria no seu negócio' },
  { titulo: 'Trabalhadoras rurais e pescadoras', texto: 'Mamães que trabalham no campo ou na pesca.', foto: '/perfil-rural.jpg', alt: 'Mulher trabalhando na lavoura' },
  { titulo: 'Desempregadas ou demitidas', texto: 'Mamães que pararam de trabalhar, mas continuam protegidas pelo INSS por um tempo, mesmo sem contribuir.', foto: '/perfil-desempregada.jpg', alt: 'Mãe em casa com o bebê', destaque: true },
];
---

<section class="secao perfis" id="quem-tem-direito">
  <div class="envelope">
    <header class="perfis__cabeca">
      <div>
        <p class="sobretitulo">Sobre o direito</p>
        <h2 class="perfis__titulo">Quem tem direito ao auxílio-maternidade?</h2>
      </div>
      <p class="perfis__sub">
        Gestantes e mães com filhos de até 5 anos que se encaixam em um destes perfis:
      </p>
    </header>

    <ul class="perfis__grade">
      {perfis.map((p) => (
        <li class={`perfil${p.destaque ? ' perfil--destaque' : ''}`}>
          <img class="perfil__foto" src={p.foto} alt={p.alt} width="800" height="600" loading="lazy" />
          <h3 class="perfil__titulo">{p.titulo}</h3>
          <p class="perfil__texto">{p.texto}</p>
        </li>
      ))}
    </ul>

    <a class="botao botao--whats perfis__botao" href={linkWhatsApp('quem tem direito')}>
      Começar teste gratuito
    </a>
  </div>
</section>

<style>
  /* Título à esquerda e frase de apoio à direita, na mesma faixa */
  .perfis__cabeca {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: 16px 48px;
    align-items: end;
  }
  .perfis__titulo { font-size: clamp(30px, 4.2vw, 44px); max-width: 16ch; }
  .perfis__sub {
    font-size: clamp(16.5px, 2vw, 18.5px);
    font-weight: 500;
    color: var(--destaque);
    max-width: 38ch;
  }

  .perfis__grade {
    list-style: none;
    margin: clamp(32px, 4.5vw, 48px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }
  .perfil {
    display: flex;
    flex-direction: column;
    background: var(--tinta);
    border-radius: 18px;
    padding: 12px 12px 24px;
  }
  .perfil__foto { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: 12px; }
  .perfil__titulo { margin-top: 16px; padding-inline: 8px; font-size: clamp(18px, 1.8vw, 20px); line-height: 1.25; }
  .perfil__texto { margin-top: 8px; padding-inline: 8px; font-size: 15.5px; line-height: 1.55; color: var(--texto-apoio); }

  .perfil--destaque { background: var(--destaque); }
  .perfil--destaque .perfil__titulo { color: #fff; }
  .perfil--destaque .perfil__texto { color: rgba(255, 255, 255, .92); }

  .perfis__botao { margin-top: clamp(28px, 4vw, 40px); }

  @media (max-width: 1040px) {
    .perfis__grade { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .perfis__cabeca { grid-template-columns: 1fr; }
  }
  @media (max-width: 580px) {
    .perfis__grade { grid-template-columns: 1fr; }
  }
  @media (max-width: 420px) { .perfis__botao { width: 100%; } }
</style>
