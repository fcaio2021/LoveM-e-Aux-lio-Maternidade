---
import { empresa, linkWhatsApp } from '../config';
---

<header class="cabecalho">
  <div class="envelope cabecalho__interno">
    <a href="/" class="cabecalho__marca" aria-label={`${empresa.nome} — início`}>
      <img src="/logo-branco.png" alt={empresa.nome} width="168" height="151" />
    </a>
    <a class="botao botao--whats cabecalho__acao" href={linkWhatsApp('topo do site')}>
      Análise gratuita
    </a>
  </div>
</header>

<style>
  /* Cabeçalho fixo em rosa, mais baixo. Sobre o rosa: logo branco (o
     colorido perderia a metade rosa) e botão branco com texto rosa (o verde
     some sobre este rosa, 1,09:1). */
  .cabecalho {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--cta);
    box-shadow: 0 2px 10px rgba(26, 37, 48, .12);
  }
  .cabecalho__interno {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 8px;
  }
  /* O logo é quase quadrado (coração sobre o nome): a largura define a
     altura da barra. 70px de largura ≈ 61px de altura. */
  .cabecalho__marca img { width: 70px; height: auto; }
  .cabecalho__acao {
    font-size: 15px;
    min-height: 40px;
    padding: 9px 20px;
    background: #fff;
    color: var(--cta);
  }
  .cabecalho__acao:hover { filter: none; }
  /* Contorno de foco branco: o rosa padrão sumiria sobre este fundo */
  .cabecalho :focus-visible { outline-color: #fff; }

  @media (max-width: 520px) {
    .cabecalho__marca img { width: 60px; }
    .cabecalho__acao { font-size: 14px; padding: 8px 16px; min-height: 38px; }
  }
</style>
