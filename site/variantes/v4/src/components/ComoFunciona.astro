---
// v4 · linha do tempo vertical: números em círculos ligados por uma linha,
// ícone ao lado do título; foto à direita com placa de cor suave atrás.
const passos = [
  { titulo: 'Análise rápida e 100% grátis', texto: 'Responda a poucas perguntas e descubra se tem direito em minutos, mesmo sem ter contribuído antes para o INSS. Quanto antes verificar, melhor.' },
  { titulo: 'Burocracia zero para você', texto: 'Nossa equipe analisa seu caso com clareza, reúne toda a papelada e faz o pedido no INSS. Verifique logo para garantir o prazo ideal da gestação.' },
  { titulo: 'Suporte e acompanhamento no WhatsApp', texto: 'Te avisamos sobre cada etapa direto no seu celular. E se o INSS negar de primeira, nós recorremos por você sem cobrar nada.' },
];
---

<section class="secao como" id="como-funciona">
  <div class="envelope como__grade">
    <div class="como__texto">
      <p class="sobretitulo">Simples assim</p>
      <h2 class="como__titulo">Como funciona?</h2>
      <p class="como__sub">
        Um processo <strong>simples e rápido</strong>. Toda burocracia fica por nossa conta.
      </p>

      <ol class="linha">
        {passos.map((passo, i) => (
          <li class="linha__passo">
            <span class="linha__numero" aria-hidden="true">{i + 1}</span>
            <div class="linha__corpo">
              <h3 class="linha__titulo">
                <span class="linha__icone" aria-hidden="true">
                  {i === 0 && (
                    <svg viewBox="0 0 48 48" fill="none" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="10" y="9" width="26" height="33" rx="4" />
                      <path d="M16 20h14M16 26.5h9" />
                      <path d="M30.5 35l2.5 2.5 4.5-5" />
                    </svg>
                  )}
                  {i === 1 && (
                    <svg viewBox="0 0 48 48" fill="none" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="9" y="13" width="23" height="29" rx="3" />
                      <path d="M16 12V9a3 3 0 0 1 3-3h14l6 6v20a3 3 0 0 1-3 3h-3" />
                      <path d="M14 22h13M14 28h13" />
                    </svg>
                  )}
                  {i === 2 && (
                    <svg viewBox="0 0 48 48" fill="none" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="8" y="6" width="20" height="36" rx="4" />
                      <path d="M25 13h13a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4h-6l-5 4v-4h-2a4 4 0 0 1-4-4v-8a4 4 0 0 1 4-4z" />
                    </svg>
                  )}
                </span>
                {passo.titulo}
              </h3>
              <p class="linha__texto">{passo.texto}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>

    <figure class="como__figura">
      <div class="como__placa" aria-hidden="true"></div>
      <img src="/mae-bebe-sorriso.jpg" alt="Mãe sorrindo com o bebê no colo" width="1400" height="2100" loading="lazy" />
    </figure>
  </div>
</section>

<style>
  .como__grade {
    display: grid;
    grid-template-columns: 1.1fr .9fr;
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }
  .como__titulo { font-size: clamp(34px, 5vw, 52px); line-height: 1.05; }
  .como__sub { margin-top: 16px; max-width: 46ch; font-size: clamp(17px, 2vw, 19px); font-weight: 500; color: var(--destaque); text-wrap: balance; }
  .como__sub strong { color: inherit; font-weight: 700; }

  .linha { list-style: none; margin: clamp(30px, 4vw, 44px) 0 0; padding: 0; }
  .linha__passo {
    position: relative;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 20px;
    padding-bottom: 30px;
  }
  .linha__passo:last-child { padding-bottom: 0; }
  /* Linha vertical ligando um número ao próximo */
  .linha__passo:not(:last-child)::before {
    content: '';
    position: absolute;
    left: 23px;
    top: 52px;
    bottom: 4px;
    width: 2px;
    background: color-mix(in srgb, var(--destaque) 30%, transparent);
  }
  .linha__numero {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--destaque);
    color: #fff;
    font-family: var(--fonte-titulo);
    font-weight: 800;
    font-size: 20px;
    box-shadow: 0 0 0 6px var(--tinta);
  }
  .linha__corpo { padding-top: 8px; }
  .linha__titulo { display: flex; align-items: center; gap: 10px; font-size: clamp(20px, 2.3vw, 23px); line-height: 1.2; }
  .linha__icone svg { display: block; width: 28px; height: 28px; stroke: var(--destaque); stroke-width: 2.4; }
  .linha__texto { margin-top: 8px; max-width: 52ch; font-size: 16.5px; line-height: 1.6; color: var(--texto-apoio); }

  .como__figura { position: relative; margin: 0; padding: 0 0 22px 22px; }
  .como__placa { position: absolute; inset: 40px 40px 0 0; background: var(--tinta); border-radius: 32px; }
  .como__figura img {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 30%;
    border-radius: 24px;
  }

  @media (max-width: 880px) {
    .como__grade { grid-template-columns: 1fr; }
    .como__figura { order: -1; max-width: 460px; }
    .como__figura img { aspect-ratio: 4 / 3.6; }
  }
</style>
